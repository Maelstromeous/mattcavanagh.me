    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "neostandard": "^0.13.0",
    "tailwindcss": "^4.3.3",
